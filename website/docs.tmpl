<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="The loop user manual: every command, the YAML schemas for pipelines and rooms, model resolution, executors, resume, the daemon and web UI.">
<link rel="icon" type="image/svg+xml" href="{{.Root}}assets/favicon.svg?v=3">
<link rel="alternate icon" type="image/png" sizes="32x32" href="{{.Root}}assets/favicon-32.png?v=3">
<link rel="stylesheet" href="{{.Root}}site.css">
</head>
<body class="docs-body">
<nav>
  <a class="brand" href="{{.Root}}index.html"><span class="brand-mark"></span>loop</a>
  <a class="on" href="{{.Root}}docs/">docs</a>
  <span class="spacer"></span>
  <a class="gh" href="https://github.com/shafi-/loop" title="github"><svg class="gh-icon" viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>
</nav>

<div class="docs">
  <aside class="toc">
    <a class="page{{if not .Active}} on{{end}}" href="{{.Root}}docs/">overview</a>
    {{range .Pages}}<a class="page{{if eq .Slug $.Active}} on{{end}}" href="{{.Href}}">{{.Title}}</a>
    {{end}}
    {{if .Subs}}
    <p class="toc-title">on this page</p>
    {{range .Subs}}<a class="lvl3" href="{{.Href}}">{{.Text}}</a>
    {{end}}
    {{end}}
  </aside>
  <main class="manual">
    {{if .Sections}}
    <div class="doccards">
      {{range .Sections}}<a class="doccard" href="{{.Href}}"><span>{{.Title}}</span><em>{{.Blurb}}</em></a>
      {{end}}
    </div>
    {{end}}
    {{.Body}}
    {{if or .Prev .Next}}
    <div class="pager">
      {{if .Prev}}<a class="prev" href="{{.Prev.Href}}"><span>← previous</span>{{.Prev.Title}}</a>{{else}}<span></span>{{end}}
      {{if .Next}}<a class="next" href="{{.Next.Href}}"><span>up next →</span>{{.Next.Title}}</a>{{end}}
    </div>
    {{end}}
  </main>
</div>

<footer>
  <span>loop — MIT licensed</span>
  <span class="spacer"></span>
